# Values must be installed separately, never shipped with the release artifact.
APP_ENV=production
DB_SCHEMA_AUTO_MIGRATE=0
# Database/security keys belong only in this file, not runtime/admin.env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=smawell_admin
PGUSER=gingtto_admin
PGPASSWORD=REPLACE_WITH_INDEPENDENT_RUNTIME_DATABASE_PASSWORD
SECURITY_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_48_BYTE_SECRET
# Admin values below. The storefront must use the separate store example.
SECURITY_ALLOWED_HOSTS=admin.gingtto.store,api-admin.gingtto.store,admin.smawell.shop,api-admin.smawell.shop,127.0.0.1
SECURITY_ALLOWED_ORIGINS=
SECURITY_PROXY_PEERS=127.0.0.1,::1
SECURITY_HSTS_MAX_AGE=300
SECURITY_CSP_ENFORCE=0
# Current cutover scope: preserve legacy attachment behavior; defer section 6.4.
SECURITY_ATTACHMENT_MODE=legacy
SECURITY_LOGIN_PROTECTION_ENABLED=0
# Change to 1 only after legacy object/CDN source URLs have been closed and tested.
SECURITY_LEGACY_SOURCES_CLOSED=0
INTERNAL_COMPAT_ENABLED=0
# Deferred media phase only: do not change the current public upload bucket.
PRIVATE_STORAGE_BUCKET=
PUBLIC_IMAGE_ORIGINS=https://img.gingtto.store,https://img.smawell.shop,https://res.cloudinary.com,https://admin.gingtto.store,https://admin.smawell.shop,https://gingtto.store,https://smawell.shop
PUBLIC_IMAGE_CORS_ORIGINS=https://gingtto.store,https://smawell.shop
SECURITY_ADMIN_FILE_ROOT=/opt/smawell/private-files/admin
SECURITY_STORE_FILE_ROOT=/opt/smawell/private-files/store
SECURITY_ADMIN_LEGACY_UPLOADS=/opt/smawell/shopify-admin/admin-backend/uploads
SECURITY_STORE_LEGACY_UPLOADS=/opt/smawell/shopify/storefront-backend/uploads
DB_STATEMENT_TIMEOUT_MS=15000
DB_EXPORT_STATEMENT_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=5000
SECURITY_LIMIT_READ=180
SECURITY_LIMIT_WRITE=60
SECURITY_LIMIT_UPLOAD=20
SECURITY_LIMIT_EXPORT=5
SECURITY_LIMIT_VOICE=120
SECURITY_LIMIT_INVENTORY=6

# Read owned upload keys directly during export; these are exact origins, not wildcards.
SECURITY_ADMIN_LEGACY_ORIGINS=https://admin.gingtto.store,https://api-admin.gingtto.store,https://admin.smawell.shop,https://api-admin.smawell.shop,https://img.gingtto.store,https://img.smawell.shop
SECURITY_STORE_LEGACY_ORIGINS=https://gingtto.store,https://www.gingtto.store,https://api.gingtto.store,https://smawell.shop,https://www.smawell.shop,https://api.smawell.shop
