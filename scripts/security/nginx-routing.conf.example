# APPROVED CUTOVER ONLY. Preserve existing verified certificate paths in each
# domain block; do not assume the gingtto certificate also covers smawell.shop.
# Install nginx-http.conf in http context and nginx-site.conf in the snippet
# path below. Validate the assembled configuration with nginx -t before reload.
# Replace *_CERT_PATH / *_KEY_PATH with existing certificate paths; never keys.

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate GINGTTO_CERT_PATH;
    ssl_certificate_key GINGTTO_KEY_PATH;
    return 444;
}
server {
    listen 443 ssl;
    server_name gingtto.store www.gingtto.store api.gingtto.store;
    ssl_certificate GINGTTO_CERT_PATH;
    ssl_certificate_key GINGTTO_KEY_PATH;
    set $gingtto_upstream 127.0.0.1:5301;
    include /etc/nginx/snippets/gingtto-security-site.conf;
    root /opt/smawell/shopify/frontend/dist;
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/gingtto-security-response-headers.conf;
        add_header Cache-Control no-store always;
    }
}
server {
    listen 443 ssl;
    server_name smawell.shop www.smawell.shop api.smawell.shop;
    ssl_certificate SMAWELL_CERT_PATH;
    ssl_certificate_key SMAWELL_KEY_PATH;
    set $gingtto_upstream 127.0.0.1:5301;
    include /etc/nginx/snippets/gingtto-security-site.conf;
    root /opt/smawell/shopify/frontend/dist;
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/gingtto-security-response-headers.conf;
        add_header Cache-Control no-store always;
    }
}
server {
    listen 443 ssl;
    server_name admin.gingtto.store api-admin.gingtto.store;
    ssl_certificate GINGTTO_CERT_PATH;
    ssl_certificate_key GINGTTO_KEY_PATH;
    set $gingtto_upstream 127.0.0.1:5302;
    include /etc/nginx/snippets/gingtto-security-site.conf;
    root /opt/smawell/shopify-admin/frontend/dist;
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/gingtto-security-response-headers.conf;
        add_header Cache-Control no-store always;
    }
}
server {
    listen 443 ssl;
    server_name admin.smawell.shop api-admin.smawell.shop;
    ssl_certificate SMAWELL_CERT_PATH;
    ssl_certificate_key SMAWELL_KEY_PATH;
    set $gingtto_upstream 127.0.0.1:5302;
    include /etc/nginx/snippets/gingtto-security-site.conf;
    root /opt/smawell/shopify-admin/frontend/dist;
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/gingtto-security-response-headers.conf;
        add_header Cache-Control no-store always;
    }
}

# Image hosts must not retain an old R2 redirect or filesystem alias. Only
# explicitly registered public product files are served through the application.
# Login, private contents, legacy public APIs and HTML are not exposed here.
server {
    listen 443 ssl;
    server_name img.gingtto.store;
    ssl_certificate GINGTTO_CERT_PATH;
    ssl_certificate_key GINGTTO_KEY_PATH;
    include /etc/nginx/snippets/gingtto-security-images.conf;
}
server {
    listen 443 ssl;
    server_name img.smawell.shop;
    ssl_certificate SMAWELL_CERT_PATH;
    ssl_certificate_key SMAWELL_KEY_PATH;
    include /etc/nginx/snippets/gingtto-security-images.conf;
}
