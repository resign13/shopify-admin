LUMIERE_SERVICE_TOKEN=lumiere-service-token
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lumiere_admin
PGUSER=postgres
PGPASSWORD=your-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=gingtto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local restore/import connections only; never set globally on production.
ORDER_NOTIFICATION_MAINTENANCE=0

# Voice delivery defaults off; generate a private signing key of at least 32 bytes.
ORDER_VOICE_ENABLED=0
ORDER_VOICE_CURSOR_SECRET=
